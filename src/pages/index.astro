---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import InteractiveGallery from '../components/InteractiveGallery.astro';
import MysteryTimeline from '../components/MysteryTimeline.astro';
import KnownUnknownMeter from '../components/KnownUnknownMeter.astro';
import CitationCard from '../components/CitationCard.astro';
import ConfidenceSlider from '../components/ConfidenceSlider.tsx';
import ObservatoryMode from '../components/ObservatoryMode.tsx';
import { getArticles, getCluster, getStations, meterEntries, knownUnknownScore } from '../lib/articles';

const articles = await getArticles();
const cluster = await getCluster('The Neutron Star Problem');
const flagship = articles[0];

// Observatory Mode stations — derived from every article's `station:` block,
// flattened to a plain serializable array for the React island.
const stations = (await getStations()).map((a) => ({
  order: a.data.order,
  title: a.data.title,
  id: a.id,
  themeColor: a.data.themeColor,
  heroImage: a.data.heroImage,
  status: a.data.status,
  question: a.data.station!.question,
  known: a.data.station!.known,
  unknown: a.data.station!.unknown,
  continueLabel: a.data.station!.continueLabel,
}));

// Aggregate, dedupe citations across published articles for the Sources section.
const seen = new Set<string>();
const sources = articles
  .filter((a) => a.data.status === 'published')
  .flatMap((a) => a.data.citations)
  .filter((c) => (seen.has(c.id) ? false : (seen.add(c.id), true)));

const premiseCards = [
  {
    title: 'What we can measure',
    body: 'Pulsar timing, gravitational waves, X-ray spectra, the cosmic microwave background. The instruments are extraordinary, and the data is real.',
    color: '#4f9cff',
  },
  {
    title: 'What we can infer',
    body: 'From the outside we reconstruct interiors, masses, and fields using models. Inference is powerful, and it carries its assumptions with it.',
    color: '#34d3c0',
  },
  {
    title: 'What we still do not know',
    body: 'The equation of state of ultra-dense matter, the nature of dark energy, what replaces a singularity. Open questions, honestly labeled.',
    color: '#ffb454',
  },
];
---

<Layout type="website">
  <Nav />
  <main id="main">
    <Hero />

    <!-- Premise -->
    <section id="premise" class="container-edge py-24">
      <div class="reveal mx-auto max-w-3xl text-center">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-neutron">The premise</p>
        <h2 class="mt-3 font-display text-4xl font-bold text-paper sm:text-5xl">Physics Is Not Finished</h2>
        <p class="mt-5 text-lg text-muted">
          This site explores real scientific frontiers where observation, theory, and math do not yet give us a
          complete picture. This is not anti-science. This is pro-science. Science is most exciting where the
          questions are still alive.
        </p>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {premiseCards.map((c) => (
          <div class="reveal glass glass-hover rounded-2xl p-6">
            <span class="mb-4 inline-block h-2.5 w-2.5 rounded-full" style={`background:${c.color}; box-shadow:0 0 12px ${c.color}`}></span>
            <h3 class="font-display text-xl font-semibold text-paper">{c.title}</h3>
            <p class="mt-3 text-sm text-muted">{c.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Featured: The Neutron Star Problem -->
    <section id="neutron-star-problem" class="container-edge py-24">
      <div class="reveal mb-12 max-w-3xl">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-amber">Featured field report</p>
        <h2 class="mt-3 font-display text-4xl font-bold text-paper sm:text-5xl">The Neutron Star Problem</h2>
        <p class="mt-5 text-lg text-muted">
          Start with a dead star so dense that a teaspoon of its material would weigh billions of tons. Its gravity is
          extreme. Its interior may contain matter we have never produced on Earth. Its surface bends light. Its clock
          runs slow. And somehow, that is just the opening act.
        </p>
      </div>
      <InteractiveGallery articles={cluster} />
    </section>

    <!-- Mystery Map -->
    <section id="mystery-map" class="container-edge py-24">
      <div class="reveal mb-12 max-w-3xl">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-neutron">The descent map</p>
        <h2 class="mt-3 font-display text-4xl font-bold text-paper sm:text-5xl">Ten Mysteries</h2>
        <p class="mt-5 text-lg text-muted">
          The deeper we go, the stranger the questions become. Each stop is a frontier where modern physics has
          evidence, models, and serious ideas, but not complete answers.
        </p>
      </div>
      <MysteryTimeline articles={articles} />
    </section>

    <!-- Observatory Mode -->
    <section id="observatory" class="container-edge py-24">
      <div class="reveal glass relative overflow-hidden rounded-3xl p-8 text-center md:p-16">
        <div class="observatory-aura" aria-hidden="true"></div>
        <div class="relative">
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-violet">The guided descent</p>
          <h2 class="mt-3 font-display text-4xl font-bold text-paper text-glow sm:text-5xl">Observatory Mode</h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg text-muted">
            An immersive, station-by-station descent through the mysteries. Each station: one dramatic question,
            one real fact, one genuine unknown. Ten stations. Ten questions. One universe acting suspicious.
          </p>
          <div class="mt-9 flex justify-center">
            <ObservatoryMode stations={stations} client:visible />
          </div>
        </div>
      </div>
    </section>

    <!-- Known Unknown Index -->
    <section id="known-unknown-index" class="container-edge py-24">
      <div class="reveal mb-12 max-w-3xl">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-violet">Known Unknown Index</p>
        <h2 class="mt-3 font-display text-4xl font-bold text-paper sm:text-5xl">Every Mystery Gets a Reading</h2>
        <p class="mt-5 text-lg text-muted">
          Some are observationally difficult. Some stress theory. Some threaten to make your brain file a workers
          compensation claim. Here is the flagship case, scored.
        </p>
      </div>
      <div class="reveal glass rounded-3xl p-6 md:p-8">
        <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="font-display text-xl font-semibold text-paper">{flagship.data.title}</h3>
          <span class="font-mono text-sm text-violet">Aggregate KU {knownUnknownScore(flagship)}/10</span>
        </div>
        <div class="grid gap-x-10 gap-y-5 md:grid-cols-2">
          {meterEntries(flagship).map((m) => (
            <KnownUnknownMeter label={m.label} value={m.value} color={flagship.data.themeColor} />
          ))}
        </div>
        {flagship.data.theoryStressNote && (
          <p class="mt-6 border-t border-line pt-4 font-mono text-sm text-muted">
            <span class="text-amber">Theory Stress note:</span> {flagship.data.theoryStressNote}
          </p>
        )}
      </div>
    </section>

    <!-- Confidence Slider -->
    <section id="confidence" class="container-edge py-24">
      <div class="reveal mx-auto max-w-3xl">
        <ConfidenceSlider client:visible />
      </div>
    </section>

    <!-- Sources -->
    <section id="sources" class="container-edge py-24">
      <div class="reveal mb-12 max-w-3xl">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-neutron">Sources</p>
        <h2 class="mt-3 font-display text-4xl font-bold text-paper sm:text-5xl">Every Claim, Traceable</h2>
        <p class="mt-5 text-lg text-muted">
          Measured facts are cited. Inferences are labeled. Hypotheses and speculation are marked as such. We do not
          present fringe ideas as settled science.
        </p>
      </div>
      <ol class="reveal grid list-none gap-4 md:grid-cols-2">
        {sources.map((c, i) => (
          <CitationCard citation={c} index={i + 1} />
        ))}
      </ol>
    </section>

    <!-- About -->
    <section id="about" class="container-edge py-24">
      <div class="reveal glass mx-auto max-w-3xl rounded-3xl p-8 text-center md:p-12">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-muted">About</p>
        <p class="mt-5 text-lg leading-relaxed text-paper/90">
          This project explores real scientific unknowns in physics and cosmology. It is built for curious adults who
          want the awe without the fake certainty. The goal is not to make physics seem weak. The goal is to show why
          science is powerful: it knows how to admit where the map ends.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .observatory-aura {
    position: absolute;
    inset: -40%;
    background: radial-gradient(circle at 50% 40%, rgba(124, 92, 255, 0.22), transparent 60%);
    animation: aura 9s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes aura {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .observatory-aura { animation: none; }
  }
</style>

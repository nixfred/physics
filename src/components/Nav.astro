---
const links = [
  { href: '/#neutron-star-problem', label: 'The Neutron Star Problem' },
  { href: '/#mystery-map', label: 'Mystery Map' },
  { href: '/#known-unknown-index', label: 'Known Unknown Index' },
  { href: '/#sources', label: 'Sources' },
  { href: '/#about', label: 'About' },
];
---

<header class="sticky top-0 z-40">
  <nav class="container-edge mt-3 flex items-center justify-between rounded-2xl glass px-4 py-3" aria-label="Primary">
    <a href="/" class="group flex items-center gap-2 font-display text-sm font-bold tracking-tight text-paper">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-neutron shadow-[0_0_12px_2px_rgba(79,156,255,0.8)]"></span>
      <span>WHERE PHYSICS STARTS SWEATING</span>
    </a>
    <ul class="hidden items-center gap-6 text-sm text-muted lg:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class="transition-colors hover:text-paper">{l.label}</a>
        </li>
      ))}
    </ul>
    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none rounded-lg border border-line px-3 py-1.5 text-sm text-paper">Menu</summary>
      <ul class="absolute right-0 mt-2 w-60 rounded-xl glass p-2 text-sm">
        {links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-lg px-3 py-2 text-muted transition-colors hover:bg-white/5 hover:text-paper">{l.label}</a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>

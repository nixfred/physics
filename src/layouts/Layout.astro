---
import '../styles/global.css';
import StarfieldBackground from '../components/StarfieldBackground.tsx';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noStarfield?: boolean;
  noindex?: boolean;
  keywords?: string[];
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  /** Extra JSON-LD graph nodes (BreadcrumbList, FAQPage) assembled by the page. */
  jsonLd?: Record<string, unknown>[];
}

const SITE_NAME = 'Where Physics Starts Sweating';
const DEFAULT_DESCRIPTION =
  'A cinematic guide to the strangest frontiers in real physics, from neutron star interiors and time dilation to black holes, missing matter, and the places where our best theories still fail.';
const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogImage = '/assets/og-default.png',
  imageAlt = 'Where Physics Starts Sweating, a field guide to the edge of known physics',
  type = 'website',
  noStarfield = false,
  noindex = false,
  keywords = [],
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  jsonLd = [],
} = Astro.props;

const siteUrl = Astro.site?.href ?? 'https://physics.nixfred.com/';
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · The Edge of Known Physics`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const logoUrl = new URL('/assets/logo.png', Astro.site).href;
const isDefaultOg = ogImage === '/assets/og-default.png';
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const publisher = {
  '@type': 'Organization',
  name: SITE_NAME,
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: logoUrl, width: 512, height: 512 },
};

const primaryJsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title ?? SITE_NAME,
        description,
        image: [ogImageUrl],
        url: canonical,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        author: publisher,
        publisher,
        ...(publishedTime && { datePublished: publishedTime }),
        ...(modifiedTime && { dateModified: modifiedTime }),
        ...(section && { articleSection: section }),
        ...(keywords.length && { keywords: keywords.join(', ') }),
        isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: siteUrl },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_NAME,
        alternateName: 'Where Physics Starts Sweating · The Edge of Known Physics',
        description,
        url: siteUrl,
        publisher,
        ...(keywords.length && { keywords: keywords.join(', ') }),
      };

const allJsonLd = [primaryJsonLd, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE_NAME} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — field reports`} href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && section && <meta property="article:section" content={section} />}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="theme-color" content="#04060d" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    {allJsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
  </head>
  <body>
    {!noStarfield && <StarfieldBackground client:idle />}
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded focus:bg-neutron focus:px-4 focus:py-2 focus:text-void">Skip to content</a>
    <slot />

    <script>
      // Scroll reveal: IntersectionObserver, reduced-motion safe (CSS handles fallback)
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .focus\:not-sr-only:focus {
    position: fixed;
    width: auto;
    height: auto;
    margin: 1rem;
    clip: auto;
    white-space: normal;
  }
</style>
